# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# Storefront token is derived from Admin API (storefrontAccessTokenCreate).
# You only need Client ID, Client Secret, Admin URL, and Storefront URL.

# Shopify Storefront API GraphQL endpoint URL
# Spec requires v2026-01 minimum. Format: https://your-store.myshopify.com/api/2026-01/graphql.json
# Newer versions (e.g. 2025-01) are also supported.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_URL=https://your-store.myshopify.com/api/2026-01/graphql.json

# -----------------------------------------------------------------------------
# Shopify Admin API (required for Storefront token derivation and Admin features)
# -----------------------------------------------------------------------------
# OAuth 2.0 client credentials (2026+). App must be installed on the store.
# Get from: Shopify Dev Dashboard > [Your app] > Settings > API credentials

SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
# Spec requires v2026-01 minimum. Format: https://your-store.myshopify.com/admin/api/2026-01/graphql.json
SHOPIFY_ADMIN_URL=https://your-store.myshopify.com/admin/api/2026-01/graphql.json


# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# Shopify (optional)
# -----------------------------------------------------------------------------
# Storefront API: if set, used directly (no Admin API token derivation). More reliable
# when OAuth/network is flaky. Get from Dev Dashboard > API credentials or run codegen once.
# SHOPIFY_STORE_FRONT_ACCESS_TOKEN=your_storefront_token

# Delegate token scope (comma-separated)
# Used for unauthenticated access to specific resources
# Example: unauthenticated_read_product_listings,unauthenticated_read_product_inventory
SHOPIFY_SCOPE=unauthenticated_read_product_listings,unauthenticated_read_product_inventory


# -----------------------------------------------------------------------------
# Site Configuration (Optional)
# -----------------------------------------------------------------------------
# Used for cookie settings, robots.txt, sitemap generation, etc.

# Your site domain (without protocol)
# Example: yourdomain.com
NEXT_PUBLIC_SITE_DOMAIN=yourdomain.com

# Base URL for the application (with protocol)
# Used for robots.txt, sitemap, and other absolute URL generation
# Example: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=https://yourdomain.com


# -----------------------------------------------------------------------------
# Analytics (Optional)
# -----------------------------------------------------------------------------
# Google Tag Manager container ID
# Get this from your Google Tag Manager account
# Format: GTM-XXXXXXX (where XXXXXXX is your container ID)
# Note: This is for GTM, not GA4. For GA4 directly, you would need a different integration.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX


# =============================================================================
# STANDARD NEXT.JS VARIABLES
# =============================================================================
# Standard Next.js environment variable
# Options: development, production, test
NODE_ENV=development


# -----------------------------------------------------------------------------
# Site Metadata (Optional)
# -----------------------------------------------------------------------------
# These variables are used for SEO, metadata, and social media links.
# If not set, default example values will be used.

# Site/Company name (used in page titles, Open Graph, etc.)
NEXT_PUBLIC_SITE_NAME=Your Company Name

# Site email address
NEXT_PUBLIC_SITE_EMAIL=contact@yourdomain.com

# Site phone number
NEXT_PUBLIC_SITE_PHONE=+1 (555) 123-4567

# Site logo URLs (absolute URLs)
NEXT_PUBLIC_SITE_LOGO=https://yourdomain.com/images/logo.png
NEXT_PUBLIC_SITE_LOGO_SQUARE=https://yourdomain.com/images/logox200.png

# Social media links
NEXT_PUBLIC_SITE_FACEBOOK=https://www.facebook.com/yourpage
NEXT_PUBLIC_SITE_INSTAGRAM=https://www.instagram.com/yourpage
NEXT_PUBLIC_SITE_TWITTER=https://twitter.com/yourpage
NEXT_PUBLIC_SITE_TWITTER_HANDLE=@yourhandle
NEXT_PUBLIC_SITE_LINKEDIN=https://www.linkedin.com/company/yourpage

# Short about/bio text (used in metadata)
NEXT_PUBLIC_SITE_ABOUT_SHORT=Your company description here


# -----------------------------------------------------------------------------
# AI Pet Portrait (Optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
UPLOADTHING_TOKEN=...
UPLOADTHING_SECRET=...

# Shopify product variant IDs for AI portrait products (create in Shopify Admin)
NEXT_PUBLIC_AI_DIGITAL_VARIANT_ID=gid://shopify/ProductVariant/...
NEXT_PUBLIC_AI_CANVAS_VARIANT_ID=gid://shopify/ProductVariant/...
NEXT_PUBLIC_AI_POSTER_VARIANT_ID=gid://shopify/ProductVariant/...


# -----------------------------------------------------------------------------
# Gelato POD (Optional)
# -----------------------------------------------------------------------------
GELATO_API_KEY=...
GELATO_CANVAS_PRODUCT_UID=canvas_40x50cm_4-0_matt_paper
GELATO_POSTER_PRODUCT_UID=poster_glossy_a3


# -----------------------------------------------------------------------------
# Webhooks & Cron (Optional)
# -----------------------------------------------------------------------------
SHOPIFY_WEBHOOK_SECRET=...
CRON_SECRET=...
